@model IEnumerable<Assignment4.Models.Product>

<div class="container mt-4">
    <h2>Product List</h2>
    <a asp-controller="Products" asp-action="Create" class="btn btn-primary mb-3">Add New Product</a>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Price ($)</th>
                <th>Quantity</th>
                <th>Weight</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Price.ToString("0.00")</td>
                    <td>@p.Quantity</td>
                    <td>@p.Weight</td>
                    <td>
                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-secondary">Edit</a>
                        <a asp-controller="Products" asp-action="Delete" asp-route-id="@p.ProductId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
